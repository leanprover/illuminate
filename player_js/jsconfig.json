{
    "compilerOptions": {
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "target": "ES2024",
        "module": "Node16",
        "moduleResolution": "Node16",
        "moduleDetection": "auto",
        "noEmit": true,
        "strict": true,
        "checkJs": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "noPropertyAccessFromIndexSignature": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "jsx": "react",
        "typeRoots": ["../vendored_js"]
    },
    "include": [
        "anim_core.js",
        "anim_data.d.ts",
        "standalone.js",
        "reveal.js",
        "color_widget.js",
        "diagram_widget.js",
        "animate_widget.js",
        "globals.d.ts",
        "infoview.d.ts"
    ]
}
